{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rinne-ops",
  "main": "ops-board/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./ops-board/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPS_STATE",
        "class_name": "OpsState"
      }
    ]
  },
  "exports": {
    "OpsState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
