{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayfinder-gallery",
  "main": "apps/wayfinder/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./apps/wayfinder/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "PULSE",
      "service": "rinne-ops"
    }
  ]
}
