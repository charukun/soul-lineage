{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soul-lineage:autonomous:experiment:2",
  "title": "Observation-first autonomous experiment plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "game",
    "mode",
    "kind",
    "problemKey",
    "observation",
    "hypothesis",
    "candidates",
    "implementation",
    "evidencePlan",
    "receipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
    },
    "game": {
      "enum": [
        "village",
        "kuumetsu"
      ]
    },
    "mode": {
      "enum": [
        "hardening",
        "evolution",
        "polish"
      ]
    },
    "kind": {
      "enum": [
        "infrastructure",
        "gameplay",
        "user-feedback"
      ]
    },
    "problemKey": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "object",
      "required": [
        "summary",
        "evidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "staging": {
          "type": "object",
          "required": [
            "kind",
            "sourceSha",
            "reference",
            "observedAt",
            "conditions",
            "notVerified"
          ],
          "properties": {
            "kind": {
              "const": "immutable-staging"
            },
            "sourceSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "conditions": {
              "type": "object"
            },
            "notVerified": {
              "type": "array"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "hypothesis": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 2
    },
    "implementation": {
      "type": "object"
    },
    "evidencePlan": {
      "type": "object",
      "required": [
        "objective",
        "focusedTests",
        "stagingAfter",
        "limitations"
      ],
      "properties": {
        "objective": {
          "const": "reproducible-causality"
        },
        "focusedTests": {
          "type": "array",
          "minItems": 1
        },
        "stagingAfter": {
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "repository",
        "pullRequest",
        "marker"
      ],
      "properties": {
        "repository": {
          "const": "charukun/soul-lineage"
        },
        "pullRequest": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "marker": {
          "type": "string"
        }
      }
    }
  }
}
