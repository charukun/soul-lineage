{
  "name": "soul-lineage mobile hybrid",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 5174, 5175],
  "portsAttributes": {
    "5173": {
      "label": "rinne / Vite",
      "onAutoForward": "notify"
    },
    "5174": {
      "label": "secondary Vite",
      "onAutoForward": "notify"
    },
    "5175": {
      "label": "secondary Vite",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node"
}
